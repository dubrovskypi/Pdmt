{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Pdmt.Api",
    "Audience": "Pdmt.Client",
    "TokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 30
  },
  "App": {
    "DefaultTimeZone": "Europe/Vilnius"
  },
  "ForwardedHeaders": {
    "TrustAllProxies": false,
    "KnownNetworks": []
  },
  "RateLimiting": {
    "Rules": {
      "Auth.Login": {
        "MaxAttempts": 5,
        "WindowSeconds": 600
      },
      "Auth.Register": {
        "MaxAttempts": 3,
        "WindowSeconds": 3600
      },
      "Auth.Refresh": {
        "MaxAttempts": 10,
        "WindowSeconds": 60
      },
      "Event.Create": {
        "MaxAttempts": 20,
        "WindowSeconds": 60
      }
    }
  }
}
