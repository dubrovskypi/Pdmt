<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pdmt.Maui.Views.InsightsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:cards="clr-namespace:Pdmt.Maui.ViewModels.Cards"
    xmlns:ic="clr-namespace:Pdmt.Maui.Views.InsightCards"
    xmlns:vm="clr-namespace:Pdmt.Maui.ViewModels"
    xmlns:views="clr-namespace:Pdmt.Maui.Views"
    x:DataType="vm:InsightsViewModel"
    Title="Insights"
    BackgroundColor="{StaticResource Background}">

    <Shell.TitleView>
        <Grid Padding="12,0" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   Text="Insights"
                   FontSize="18" FontAttributes="Bold"
                   TextColor="{StaticResource OnSurface}"
                   VerticalOptions="Center" />
            <Label Grid.Column="1"
                   Text="{Binding CardCounterLabel}"
                   FontSize="13"
                   TextColor="{StaticResource OnSurfaceVariant}"
                   VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>

    <ContentPage.Resources>

        <DataTemplate x:Key="Card01Template" x:DataType="cards:Card01IntenseTagsViewModel">
            <ic:Card01IntenseTagsView />
        </DataTemplate>
        <DataTemplate x:Key="Card02Template" x:DataType="cards:Card02RepeatingViewModel">
            <ic:Card02RepeatingView />
        </DataTemplate>
        <DataTemplate x:Key="Card03Template" x:DataType="cards:Card03BalanceViewModel">
            <ic:Card03BalanceView />
        </DataTemplate>
        <DataTemplate x:Key="Card04Template" x:DataType="cards:Card04TrendViewModel">
            <ic:Card04TrendView />
        </DataTemplate>
        <DataTemplate x:Key="Card05Template" x:DataType="cards:Card05DiscountedPosViewModel">
            <ic:Card05DiscountedPosView />
        </DataTemplate>
        <DataTemplate x:Key="Card06Template" x:DataType="cards:Card06WeekdaysViewModel">
            <ic:Card06WeekdaysView />
        </DataTemplate>
        <DataTemplate x:Key="Card07Template" x:DataType="cards:Card07NextDayViewModel">
            <ic:Card07NextDayView />
        </DataTemplate>
        <DataTemplate x:Key="Card08Template" x:DataType="cards:Card08TagCombosViewModel">
            <ic:Card08TagCombosView />
        </DataTemplate>
        <DataTemplate x:Key="Card09Template" x:DataType="cards:Card09TagTrendViewModel">
            <ic:Card09TagTrendView />
        </DataTemplate>
        <DataTemplate x:Key="Card10Template" x:DataType="cards:Card10InfluenceViewModel">
            <ic:Card10InfluenceView />
        </DataTemplate>

        <views:InsightCardTemplateSelector x:Key="CardSelector"
            Card01Template="{StaticResource Card01Template}"
            Card02Template="{StaticResource Card02Template}"
            Card03Template="{StaticResource Card03Template}"
            Card04Template="{StaticResource Card04Template}"
            Card05Template="{StaticResource Card05Template}"
            Card06Template="{StaticResource Card06Template}"
            Card07Template="{StaticResource Card07Template}"
            Card08Template="{StaticResource Card08Template}"
            Card09Template="{StaticResource Card09Template}"
            Card10Template="{StaticResource Card10Template}" />

    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Row 0: Period pill toggle -->
        <Border Grid.Row="0" Margin="12,8,12,4"
                StrokeShape="RoundRectangle 100"
                Stroke="{StaticResource Border}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource SurfaceVariant}"
                Padding="2"
                HorizontalOptions="Center">
            <HorizontalStackLayout Spacing="0">

                <Border StrokeShape="RoundRectangle 100" StrokeThickness="0" Padding="16,6"
                        BackgroundColor="{Binding WeekChipBg}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPeriodCommand}"
                                              CommandParameter="{Binding PeriodOptions[0]}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding PeriodOptions[0].Label}"
                           FontSize="12" FontAttributes="Bold"
                           TextColor="{Binding WeekChipText}" />
                </Border>

                <Border StrokeShape="RoundRectangle 100" StrokeThickness="0" Padding="16,6"
                        BackgroundColor="{Binding TwoWeeksChipBg}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPeriodCommand}"
                                              CommandParameter="{Binding PeriodOptions[1]}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding PeriodOptions[1].Label}"
                           FontSize="12" FontAttributes="Bold"
                           TextColor="{Binding TwoWeeksChipText}" />
                </Border>

                <Border StrokeShape="RoundRectangle 100" StrokeThickness="0" Padding="16,6"
                        BackgroundColor="{Binding MonthChipBg}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPeriodCommand}"
                                              CommandParameter="{Binding PeriodOptions[2]}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding PeriodOptions[2].Label}"
                           FontSize="12" FontAttributes="Bold"
                           TextColor="{Binding MonthChipText}" />
                </Border>

            </HorizontalStackLayout>
        </Border>

        <!-- Row 1: Carousel -->
        <CarouselView
            Grid.Row="1"
            x:Name="InsightsCarousel"
            ItemsSource="{Binding Cards}"
            ItemTemplate="{StaticResource CardSelector}"
            PeekAreaInsets="20"
            Loop="False"
            Position="{Binding CurrentPosition, Mode=TwoWay}">
            <CarouselView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CarouselView.ItemsLayout>
        </CarouselView>

        <!-- Page-level loading overlay -->
        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsPageLoading}"
            IsVisible="{Binding IsPageLoading}"
            Color="{StaticResource Primary}"
            VerticalOptions="Center"
            HorizontalOptions="Center" />

        <!-- Row 2: Tappable dot indicators -->
        <HorizontalStackLayout
            Grid.Row="2"
            Spacing="4"
            HorizontalOptions="Center"
            Margin="0,4,0,12"
            BindableLayout.ItemsSource="{Binding Dots}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:DotViewModel">
                    <Border WidthRequest="24" HeightRequest="24"
                            StrokeThickness="0" BackgroundColor="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference InsightsCarousel}, Path=BindingContext.GoToCardCommand}"
                                CommandParameter="{Binding Index}" />
                        </Border.GestureRecognizers>
                        <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                 Color="{Binding DotColor}"
                                 HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>
