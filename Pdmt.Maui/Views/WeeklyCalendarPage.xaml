<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pdmt.Maui.Views.WeeklyCalendarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:Pdmt.Maui.Converters"
    xmlns:models="clr-namespace:Pdmt.Maui.Models"
    xmlns:vm="clr-namespace:Pdmt.Maui.ViewModels"
    x:DataType="vm:WeeklyCalendarViewModel"
    BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <conv:NotNullToBoolConverter x:Key="NotNullToBool" />
    </ContentPage.Resources>

    <Shell.TitleView>
        <Grid Padding="8,0">
            <Label
                Text="Calendar"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{StaticResource OnSurface}"
                VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Error banner -->
        <Label
            Grid.Row="0"
            Style="{StaticResource ErrorLabel}"
            Text="{Binding ErrorMessage}"
            IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullToBool}}"
            BackgroundColor="{StaticResource NegativeBg}"
            Padding="16,8" />

        <!-- Sub-header: ‹/› + period label + Week/Month toggle -->
        <Grid
            Grid.Row="1"
            Padding="12,8"
            ColumnDefinitions="Auto,Auto,*,Auto"
            ColumnSpacing="6">

            <Button
                Grid.Column="0"
                Text="‹"
                Style="{StaticResource IconCircleButton}"
                Command="{Binding PrevPeriodCommand}" />

            <Button
                Grid.Column="1"
                Text="›"
                Style="{StaticResource IconCircleButton}"
                Command="{Binding NextPeriodCommand}" />

            <Label
                Grid.Column="2"
                Text="{Binding PeriodLabel}"
                FontSize="13"
                FontAttributes="Bold"
                TextColor="{StaticResource OnSurface}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <!-- Week / Month toggle pill -->
            <Border
                Grid.Column="3"
                StrokeShape="RoundRectangle 100"
                Stroke="{StaticResource Border}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource SurfaceVariant}"
                Padding="2">
                <HorizontalStackLayout Spacing="0">
                    <Border
                        StrokeShape="RoundRectangle 100"
                        StrokeThickness="0"
                        Padding="12,4"
                        BackgroundColor="{Binding WeekModeBg}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetViewModeCommand}" CommandParameter="week" />
                        </Border.GestureRecognizers>
                        <Label
                            Text="Week"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{Binding WeekModeText}" />
                    </Border>
                    <Border
                        StrokeShape="RoundRectangle 100"
                        StrokeThickness="0"
                        Padding="12,4"
                        BackgroundColor="{Binding MonthModeBg}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetViewModeCommand}" CommandParameter="month" />
                        </Border.GestureRecognizers>
                        <Label
                            Text="Month"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{Binding MonthModeText}" />
                    </Border>
                </HorizontalStackLayout>
            </Border>

        </Grid>

        <!-- ── Week view ── -->
        <CollectionView
            Grid.Row="2"
            IsVisible="{Binding IsWeekMode}"
            ItemsSource="{Binding Days}"
            Margin="12,0,12,12">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CalendarDayViewModel">
                    <VerticalStackLayout Margin="0,4,0,0" Spacing="0">

                        <!-- Day card header -->
                        <Border
                            Padding="10,8"
                            StrokeShape="RoundRectangle 8,8,0,0"
                            BackgroundColor="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WeeklyCalendarViewModel}}, Path=ToggleDayCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="52,*,68" ColumnSpacing="8">

                                <!-- Day label -->
                                <VerticalStackLayout
                                    Grid.Column="0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Spacing="0">
                                    <Label
                                        Text="{Binding DayAbbrev}"
                                        FontSize="10"
                                        TextColor="{StaticResource Muted}"
                                        HorizontalOptions="Center"
                                        CharacterSpacing="1" />
                                    <Label
                                        Text="{Binding DayNumber}"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource OnSurface}"
                                        HorizontalOptions="Center" />
                                </VerticalStackLayout>

                                <!-- Center: tags + histogram -->
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">

                                    <!-- Positive tags above -->
                                    <Grid ColumnDefinitions="*,*" IsVisible="{Binding HasPosTags}">
                                        <HorizontalStackLayout
                                            Grid.Column="0"
                                            HorizontalOptions="End"
                                            Spacing="4"
                                            BindableLayout.ItemsSource="{Binding TopPositiveTags}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:TagCountDto">
                                                    <Border
                                                        BackgroundColor="{StaticResource PositiveBg}"
                                                        Stroke="Transparent"
                                                        StrokeThickness="0"
                                                        Padding="5,1">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="10" />
                                                        </Border.StrokeShape>
                                                        <Label
                                                            Text="{Binding Name}"
                                                            TextColor="{StaticResource PositiveText}"
                                                            FontSize="11" />
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <!-- Empty day label -->
                                    <Label
                                        Text="no events"
                                        FontSize="11"
                                        TextColor="{StaticResource Muted}"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding IsEmpty}" />

                                    <!-- Histogram -->
                                    <Grid ColumnDefinitions="18,*,2,*,18" HeightRequest="22" IsVisible="{Binding HasEvents}">

                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding PosCountText}"
                                            TextColor="{StaticResource Positive}"
                                            FontSize="11"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center" />

                                        <Grid Grid.Column="1" VerticalOptions="Center">
                                            <BoxView
                                                HorizontalOptions="End"
                                                VerticalOptions="Center"
                                                WidthRequest="{Binding PosBarWidth}"
                                                HeightRequest="12"
                                                Color="{StaticResource PositiveBar}"
                                                CornerRadius="2,0,2,0" />
                                        </Grid>

                                        <BoxView
                                            Grid.Column="2"
                                            Color="{StaticResource Border}"
                                            HeightRequest="18"
                                            WidthRequest="2"
                                            VerticalOptions="Center" />

                                        <Grid Grid.Column="3" VerticalOptions="Center">
                                            <BoxView
                                                HorizontalOptions="Start"
                                                VerticalOptions="Center"
                                                WidthRequest="{Binding NegBarWidth}"
                                                HeightRequest="12"
                                                Color="{StaticResource NegativeBar}"
                                                CornerRadius="0,2,0,2" />
                                        </Grid>

                                        <Label
                                            Grid.Column="4"
                                            Text="{Binding NegCountText}"
                                            TextColor="{StaticResource Negative}"
                                            FontSize="11"
                                            VerticalOptions="Center" />

                                    </Grid>

                                    <!-- Negative tags below -->
                                    <Grid ColumnDefinitions="*,*" IsVisible="{Binding HasNegTags}">
                                        <HorizontalStackLayout
                                            Grid.Column="1"
                                            HorizontalOptions="Start"
                                            Spacing="4"
                                            BindableLayout.ItemsSource="{Binding TopNegativeTags}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:TagCountDto">
                                                    <Border
                                                        BackgroundColor="{StaticResource NegativeBg}"
                                                        Stroke="Transparent"
                                                        StrokeThickness="0"
                                                        Padding="5,1">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="10" />
                                                        </Border.StrokeShape>
                                                        <Label
                                                            Text="{Binding Name}"
                                                            TextColor="{StaticResource NegativeText}"
                                                            FontSize="11" />
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </HorizontalStackLayout>
                                    </Grid>

                                </VerticalStackLayout>

                                <!-- Day score -->
                                <VerticalStackLayout
                                    Grid.Column="2"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Spacing="2"
                                    IsVisible="{Binding HasEvents}">
                                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                                        <BoxView
                                            WidthRequest="8"
                                            HeightRequest="8"
                                            CornerRadius="4"
                                            Color="{Binding DotColor}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Text="{Binding ScoreAbsolute, StringFormat='{0:F1}'}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource OnSurface}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label
                                        Text="{Binding ScoreLabel}"
                                        FontSize="11"
                                        TextColor="{StaticResource Muted}"
                                        HorizontalOptions="Center" />
                                </VerticalStackLayout>

                            </Grid>
                        </Border>

                        <!-- Expanded events panel -->
                        <Border
                            IsVisible="{Binding IsExpanded}"
                            Padding="10,8"
                            BackgroundColor="{StaticResource Card}"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="0,0,8,8" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="0">

                                <ActivityIndicator
                                    IsRunning="{Binding IsExpandedLoading}"
                                    IsVisible="{Binding IsExpandedLoading}"
                                    Color="{StaticResource Primary}"
                                    HorizontalOptions="Center"
                                    Margin="0,8" />

                                <Label
                                    Text="No events on this day."
                                    Style="{StaticResource MutedLabel}"
                                    HorizontalOptions="Center"
                                    Margin="0,8"
                                    IsVisible="{Binding IsExpandedEmpty}" />

                                <VerticalStackLayout
                                    BindableLayout.ItemsSource="{Binding ExpandedEvents}"
                                    Spacing="0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CalendarEventViewModel">
                                            <Grid
                                                ColumnDefinitions="30,*,44"
                                                ColumnSpacing="8"
                                                Padding="0,6,0,6">

                                                <Label
                                                    Text="{Binding IntensityText}"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    TextColor="{Binding TypeColor}"
                                                    HorizontalOptions="End" />

                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label
                                                        Text="{Binding Title}"
                                                        FontAttributes="Bold"
                                                        FontSize="14" />
                                                    <Label
                                                        Text="{Binding Description}"
                                                        FontSize="12"
                                                        TextColor="{StaticResource Muted}"
                                                        IsVisible="{Binding HasDescription}" />
                                                    <Label
                                                        Text="{Binding TagsSummary}"
                                                        Style="{StaticResource MutedLabel}"
                                                        IsVisible="{Binding HasTags}" />
                                                </VerticalStackLayout>

                                                <VerticalStackLayout
                                                    Grid.Column="2"
                                                    HorizontalOptions="End"
                                                    Spacing="2">
                                                    <Label
                                                        Text="{Binding TimeText}"
                                                        Style="{StaticResource MutedLabel}"
                                                        HorizontalOptions="End" />
                                                </VerticalStackLayout>

                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- ── Month view ── -->
        <ScrollView Grid.Row="2" IsVisible="{Binding IsMonthMode}" Padding="12,4,12,12">
            <VerticalStackLayout Spacing="12">

                <!-- Weekday header -->
                <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                    <Label Grid.Column="0" Text="MON" FontSize="10" TextColor="{StaticResource Muted}" HorizontalOptions="Center" />
                    <Label Grid.Column="1" Text="TUE" FontSize="10" TextColor="{StaticResource Muted}" HorizontalOptions="Center" />
                    <Label Grid.Column="2" Text="WED" FontSize="10" TextColor="{StaticResource Muted}" HorizontalOptions="Center" />
                    <Label Grid.Column="3" Text="THU" FontSize="10" TextColor="{StaticResource Muted}" HorizontalOptions="Center" />
                    <Label Grid.Column="4" Text="FRI" FontSize="10" TextColor="{StaticResource Muted}" HorizontalOptions="Center" />
                    <Label Grid.Column="5" Text="SAT" FontSize="10" TextColor="{StaticResource Muted}" HorizontalOptions="Center" />
                    <Label Grid.Column="6" Text="SUN" FontSize="10" TextColor="{StaticResource Muted}" HorizontalOptions="Center" />
                </Grid>

                <!-- Day cells grid -->
                <CollectionView ItemsSource="{Binding MonthDays}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            Orientation="Vertical"
                            Span="7"
                            HorizontalItemSpacing="3"
                            VerticalItemSpacing="3" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MonthDayCellViewModel">
                            <Border
                                MinimumHeightRequest="52"
                                StrokeShape="RoundRectangle 6"
                                Stroke="{Binding CellBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{Binding CellBackground}"
                                Padding="4,3">
                                <Grid RowDefinitions="Auto,*,3">

                                    <!-- Day number -->
                                    <Label
                                        Grid.Row="0"
                                        Text="{Binding DayNumber}"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource OnSurface}" />

                                    <!-- Event dots -->
                                    <HorizontalStackLayout
                                        Grid.Row="1"
                                        Spacing="2"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding HasEvents}">
                                        <BoxView
                                            WidthRequest="4"
                                            HeightRequest="4"
                                            CornerRadius="2"
                                            Color="{StaticResource PositiveBar}"
                                            IsVisible="{Binding HasPositive}" />
                                        <BoxView
                                            WidthRequest="4"
                                            HeightRequest="4"
                                            CornerRadius="2"
                                            Color="{StaticResource NegativeBar}"
                                            IsVisible="{Binding HasNegative}" />
                                    </HorizontalStackLayout>

                                    <!-- Intensity bar -->
                                    <BoxView
                                        Grid.Row="2"
                                        HeightRequest="3"
                                        HorizontalOptions="Start"
                                        WidthRequest="{Binding IntensityBarWidth}"
                                        Color="{Binding IntensityBarColor}"
                                        IsVisible="{Binding HasEvents}" />

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Monthly summary card -->
                <Border Style="{StaticResource CardSurface}">
                    <VerticalStackLayout Spacing="10">

                        <Label Text="{Binding MonthSummaryHeader}" Style="{StaticResource SectionLabel}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Border
                                Grid.Column="0"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource PositiveBg}"
                                Padding="10,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="POSITIVE" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource PositiveText}" />
                                    <Label Text="{Binding MonthPosTotal}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource PositiveText}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border
                                Grid.Column="1"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource NegativeBg}"
                                Padding="10,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="NEGATIVE" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource NegativeText}" />
                                    <Label Text="{Binding MonthNegTotal}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource NegativeText}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Best day" FontSize="10" TextColor="{StaticResource Muted}" />
                                <Label Text="{Binding MonthBestDayLabel}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Positive}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Worst day" FontSize="10" TextColor="{StaticResource Muted}" />
                                <Label Text="{Binding MonthWorstDayLabel}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Negative}" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading overlay -->
        <ActivityIndicator
            Grid.Row="2"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{StaticResource Primary}"
            VerticalOptions="Center"
            HorizontalOptions="Center" />

    </Grid>
</ContentPage>
