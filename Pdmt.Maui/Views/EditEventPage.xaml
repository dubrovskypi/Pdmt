<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pdmt.Maui.Views.EditEventPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:Pdmt.Maui.Converters"
    xmlns:models="clr-namespace:Pdmt.Maui.Models"
    xmlns:vm="clr-namespace:Pdmt.Maui.ViewModels"
    x:DataType="vm:EditEventViewModel"
    Title="Edit event"
    BackgroundColor="#f9f9f9">

    <ContentPage.Resources>
        <conv:NotNullToBoolConverter x:Key="NotNullToBool" />
        <conv:InvertBoolConverter x:Key="InvertBool" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- ROW 0 — Critical fields (never scroll, always above keyboard) -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="16,14,16,0"
            Spacing="12">

            <!-- Type toggle -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" HeightRequest="48">

                <Border
                    Grid.Column="0"
                    BackgroundColor="{Binding PositiveBtnBg}"
                    Stroke="{Binding PositiveBtnBorder}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 10">
                    <Label
                        Text="+ Positive"
                        TextColor="{Binding PositiveBtnText}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        FontAttributes="Bold"
                        FontSize="14" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetPositiveCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <Border
                    Grid.Column="1"
                    BackgroundColor="{Binding NegativeBtnBg}"
                    Stroke="{Binding NegativeBtnBorder}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 10">
                    <Label
                        Text="− Negative"
                        TextColor="{Binding NegativeBtnText}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        FontAttributes="Bold"
                        FontSize="14" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetNegativeCommand}" />
                    </Border.GestureRecognizers>
                </Border>

            </Grid>

            <!-- Title -->
            <VerticalStackLayout Spacing="4">
                <Label Text="TITLE" Style="{StaticResource SectionLabel}" />
                <Border
                    BackgroundColor="White"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 10"
                    Padding="8,0">
                    <Entry
                        Placeholder="What happened?"
                        Text="{Binding Title}"
                        FontSize="16"
                        ReturnType="Done" />
                </Border>
            </VerticalStackLayout>

            <!-- Intensity -->
            <VerticalStackLayout Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="INTENSITY" Style="{StaticResource SectionLabel}" />
                    <Label
                        Grid.Column="1"
                        Text="{Binding Intensity, StringFormat='{0}/10'}"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{Binding IntensityLabelColor}" />
                </Grid>
                <FlexLayout
                    BindableLayout.ItemsSource="{Binding IntensitySegments}"
                    Direction="Row">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:IntensitySegment">
                            <Grid HeightRequest="36" Padding="1,0" FlexLayout.Grow="1">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EditEventViewModel}}, Path=SetIntensityCommand}"
                                        CommandParameter="{Binding Index}" />
                                </Grid.GestureRecognizers>
                                <Border
                                    BackgroundColor="{Binding BackgroundColor}"
                                    Opacity="{Binding Opacity}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 6" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
                <Grid ColumnDefinitions="*,*">
                    <Label Grid.Column="0" Text="neutral" FontSize="10" TextColor="{StaticResource Muted}" />
                    <Label Grid.Column="1" Text="max" FontSize="10" TextColor="{StaticResource Muted}" HorizontalOptions="End" />
                </Grid>
            </VerticalStackLayout>

            <!-- Tags -->
            <VerticalStackLayout Spacing="6">
                <Label Text="TAGS" Style="{StaticResource SectionLabel}" />

                <!-- Selected tag pills -->
                <FlexLayout
                    BindableLayout.ItemsSource="{Binding SelectedTags}"
                    Wrap="Wrap"
                    Direction="Row"
                    JustifyContent="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border
                                BackgroundColor="{Binding Source={RelativeSource AncestorType={x:Type vm:EditEventViewModel}}, Path=TagChipBg}"
                                Stroke="{Binding Source={RelativeSource AncestorType={x:Type vm:EditEventViewModel}}, Path=TagChipBorder}"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 100"
                                Padding="10,5"
                                Margin="0,3,6,3">
                                <HorizontalStackLayout Spacing="4">
                                    <Label
                                        Text="{Binding .}"
                                        TextColor="{Binding Source={RelativeSource AncestorType={x:Type vm:EditEventViewModel}}, Path=TagChipText}"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center" />
                                    <Label
                                        Text="×"
                                        FontSize="15"
                                        TextColor="{Binding Source={RelativeSource AncestorType={x:Type vm:EditEventViewModel}}, Path=TagChipText}"
                                        VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EditEventViewModel}}, Path=RemoveTagCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- Custom tag input row -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <Border
                        Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 10"
                        Padding="4,0">
                        <Entry
                            Placeholder="Custom tag…"
                            Text="{Binding TagInput}"
                            ReturnCommand="{Binding CommitTagInputCommand}"
                            ReturnType="Done"
                            FontSize="14" />
                    </Border>
                    <Button
                        Grid.Column="1"
                        Text="Add"
                        Command="{Binding CommitTagInputCommand}"
                        BackgroundColor="#006a60"
                        IsVisible="{Binding TagInput, Converter={StaticResource NotNullToBool}}"
                        CornerRadius="8"
                        FontSize="13"
                        Padding="12,7" />
                </Grid>

                <!-- API suggestions dropdown -->
                <Border
                    IsVisible="{Binding HasSuggestions}"
                    Padding="0"
                    BackgroundColor="White"
                    Stroke="{StaticResource Border}"
                    StrokeShape="RoundRectangle 8">
                    <CollectionView ItemsSource="{Binding TagSuggestions}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label
                                    Text="{Binding .}"
                                    Padding="12,8"
                                    BackgroundColor="White">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EditEventViewModel}}, Path=SelectSuggestionCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- ROW 1 — Optional section (scrollable) -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,4,16,32" Spacing="12">

                <!-- Divider + label -->
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,4" />
                <Label Text="OPTIONAL" Style="{StaticResource SectionLabel}" />

                <!-- Error -->
                <Label
                    Style="{StaticResource ErrorLabel}"
                    Text="{Binding ErrorMessage}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullToBool}}" />

                <!-- Context -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="CONTEXT" Style="{StaticResource SectionLabel}" />
                    <Border
                        Padding="4,0"
                        BackgroundColor="White"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 10">
                        <Entry
                            Placeholder="Where / when (optional)"
                            Text="{Binding Context}"
                            FontSize="14" />
                    </Border>
                </VerticalStackLayout>

                <!-- Description -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="DESCRIPTION" Style="{StaticResource SectionLabel}" />
                    <Border
                        Padding="4,0"
                        BackgroundColor="White"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 10">
                        <Editor
                            Placeholder="Add details…"
                            Text="{Binding Description}"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="80"
                            FontSize="14" />
                    </Border>
                </VerticalStackLayout>

                <!-- Can Influence -->
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleInfluenceCommand}" />
                    </Grid.GestureRecognizers>
                    <Switch
                        Grid.Column="0"
                        IsToggled="{Binding CanInfluence}"
                        OnColor="{StaticResource PositiveBar}"
                        VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="I can influence" FontSize="13" VerticalOptions="Center"/>
                </Grid>

                <!-- Event time (only on Edit screen) -->
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="EVENT TIME" Style="{StaticResource SectionLabel}" />
                        <Border
                            Grid.Column="1"
                            Padding="8,4"
                            BackgroundColor="Transparent"
                            StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleTimestampLockCommand}" />
                            </Border.GestureRecognizers>
                            <Label
                                FontSize="12"
                                TextColor="#006a60"
                                VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsTimestampLocked}" Value="True">
                                        <Setter Property="Text" Value="🔒 Edit" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsTimestampLocked}" Value="False">
                                        <Setter Property="Text" Value="🔓 Lock" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Border
                            Grid.Column="0"
                            Padding="8,0"
                            BackgroundColor="White"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 10">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsTimestampLocked}" Value="True">
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Border.Triggers>
                            <DatePicker
                                Date="{Binding EventDate}"
                                Format="dd MMM yyyy"
                                IsEnabled="{Binding IsTimestampLocked, Converter={StaticResource InvertBool}}" />
                        </Border>
                        <Border
                            Grid.Column="1"
                            Padding="8,0"
                            BackgroundColor="White"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 10">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsTimestampLocked}" Value="True">
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Border.Triggers>
                            <TimePicker
                                Time="{Binding EventTime}"
                                Format="HH:mm"
                                IsEnabled="{Binding IsTimestampLocked, Converter={StaticResource InvertBool}}" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- Loading indicator -->
                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="#006a60"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
