<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pdmt.Maui.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:Pdmt.Maui.Converters"
    xmlns:vm="clr-namespace:Pdmt.Maui.ViewModels"
    x:DataType="vm:RegisterViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource PrimaryContainer}">

    <ContentPage.Resources>
        <conv:NotNullToBoolConverter x:Key="NotNullToBool" />
        <conv:InvertBoolConverter x:Key="InvertBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <!-- Hero zone -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="8"
            HorizontalOptions="Center"
            VerticalOptions="Center">
            <Image
                Source="logo.svg"
                HeightRequest="56"
                WidthRequest="56"
                HorizontalOptions="Center" />
            <Label
                Text="Pdmt"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="{StaticResource Primary}"
                HorizontalOptions="Center" />
            <Label
                Text="Personal Event Tracker"
                FontSize="13"
                TextColor="{StaticResource Primary}"
                Opacity="0.7"
                HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Bottom-sheet form -->
        <Border Grid.Row="1" Style="{StaticResource BottomSheetSurface}">
            <VerticalStackLayout Spacing="14">

                <BoxView
                    WidthRequest="36"
                    HeightRequest="4"
                    Color="{StaticResource Border}"
                    HorizontalOptions="Center"
                    Margin="0,0,0,6" />

                <Label
                    Text="Create account"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="{StaticResource OnSurface}" />

                <Label
                    Style="{StaticResource ErrorLabel}"
                    Text="{Binding ErrorMessage}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullToBool}}" />

                <Entry
                    Placeholder="Email"
                    Text="{Binding Email}"
                    Keyboard="Email"
                    ReturnType="Next" />

                <Entry
                    Placeholder="Password"
                    Text="{Binding Password}"
                    IsPassword="True"
                    ReturnType="Next" />

                <Entry
                    Placeholder="Confirm password"
                    Text="{Binding ConfirmPassword}"
                    IsPassword="True"
                    ReturnType="Done"
                    ReturnCommand="{Binding RegisterCommand}" />

                <Button
                    Text="Sign up"
                    Style="{StaticResource PrimaryFilledButton}"
                    Command="{Binding RegisterCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{StaticResource Primary}"
                    HorizontalOptions="Center" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="2">
                    <Label
                        Text="Have account?"
                        VerticalOptions="Center"
                        FontSize="13"
                        TextColor="{StaticResource Muted}" />
                    <Button
                        Text="Sign in"
                        Style="{StaticResource LinkButton}"
                        Command="{Binding GoToLoginCommand}" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
