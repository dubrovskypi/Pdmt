<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pdmt.Maui.Views.NewEventPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:Pdmt.Maui.Converters"
    xmlns:models="clr-namespace:Pdmt.Maui.Models"
    xmlns:vm="clr-namespace:Pdmt.Maui.ViewModels"
    x:DataType="vm:NewEventViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <conv:NotNullToBoolConverter x:Key="NotNullToBool" />
        <conv:InvertBoolConverter x:Key="InvertBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Sticky header -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto"
            Padding="8,0"
            BackgroundColor="{StaticResource Background}">
            <ImageButton
                Grid.Column="0"
                Source="ic_arrow_back.svg"
                BackgroundColor="Transparent"
                HeightRequest="48"
                WidthRequest="48"
                Padding="12"
                Command="{Binding CancelCommand}" />
            <Label
                Grid.Column="1"
                Text="New event"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{StaticResource OnSurface}"
                VerticalOptions="Center" />
            <Button
                Grid.Column="2"
                Text="Log event"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding CanSave}"
                BackgroundColor="{Binding SaveButtonBg}"
                TextColor="{Binding SaveButtonTextColor}"
                HeightRequest="48"
                CornerRadius="14"
                FontSize="15"
                FontAttributes="Bold"
                Margin="0,0,10,0" />
        </Grid>

        <!-- Scrollable form -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14,16,8" Spacing="12">

                <!-- Type toggle -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" HeightRequest="48">

                    <Border
                        Grid.Column="0"
                        BackgroundColor="{Binding PositiveBtnBg}"
                        Stroke="{Binding PositiveBtnBorder}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 10">
                        <Label
                            Text="+ Positive"
                            TextColor="{Binding PositiveBtnText}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            FontAttributes="Bold"
                            FontSize="14" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetPositiveCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border
                        Grid.Column="1"
                        BackgroundColor="{Binding NegativeBtnBg}"
                        Stroke="{Binding NegativeBtnBorder}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 10">
                        <Label
                            Text="− Negative"
                            TextColor="{Binding NegativeBtnText}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            FontAttributes="Bold"
                            FontSize="14" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetNegativeCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                </Grid>

                <!-- Title -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="TITLE *" Style="{StaticResource SectionLabel}" />
                    <Border
                        BackgroundColor="{StaticResource Card}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 10"
                        Padding="8,0">
                        <Entry
                            Placeholder="What happened?"
                            Text="{Binding Title}"
                            FontSize="16"
                            ReturnType="Done" />
                    </Border>
                </VerticalStackLayout>

                <!-- Intensity -->
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="INTENSITY" Style="{StaticResource SectionLabel}" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding Intensity, StringFormat='{0}/10'}"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="{Binding IntensityLabelColor}" />
                    </Grid>
                    <FlexLayout
                        BindableLayout.ItemsSource="{Binding IntensitySegments}"
                        Direction="Row">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:IntensitySegment">
                                <Grid HeightRequest="36" Padding="1,0" FlexLayout.Grow="1">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NewEventViewModel}}, Path=SetIntensityCommand}"
                                            CommandParameter="{Binding Index}" />
                                    </Grid.GestureRecognizers>
                                    <Border
                                        BackgroundColor="{Binding BackgroundColor}"
                                        Opacity="{Binding Opacity}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <Grid ColumnDefinitions="*,*">
                        <Label Grid.Column="0" Text="neutral" FontSize="10" TextColor="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="max" FontSize="10" TextColor="{StaticResource Muted}" HorizontalOptions="End" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Tags -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="TAGS" Style="{StaticResource SectionLabel}" />

                    <FlexLayout
                        BindableLayout.ItemsSource="{Binding SelectedTags}"
                        Wrap="Wrap"
                        Direction="Row"
                        JustifyContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border
                                    BackgroundColor="{Binding Source={RelativeSource AncestorType={x:Type vm:NewEventViewModel}}, Path=TagChipBg}"
                                    Stroke="{Binding Source={RelativeSource AncestorType={x:Type vm:NewEventViewModel}}, Path=TagChipBorder}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 100"
                                    Padding="10,5"
                                    Margin="0,3,6,3">
                                    <HorizontalStackLayout Spacing="4">
                                        <Label
                                            Text="{Binding .}"
                                            TextColor="{Binding Source={RelativeSource AncestorType={x:Type vm:NewEventViewModel}}, Path=TagChipText}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            VerticalOptions="Center" />
                                        <Label
                                            Text="×"
                                            FontSize="15"
                                            TextColor="{Binding Source={RelativeSource AncestorType={x:Type vm:NewEventViewModel}}, Path=TagChipText}"
                                            VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NewEventViewModel}}, Path=RemoveTagCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Border
                        IsVisible="{Binding HasSuggestions}"
                        Padding="0"
                        BackgroundColor="{StaticResource Card}"
                        Stroke="{StaticResource Border}"
                        StrokeShape="RoundRectangle 8">
                        <CollectionView ItemsSource="{Binding TagSuggestions}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label
                                        Text="{Binding .}"
                                        Padding="12,8"
                                        BackgroundColor="{StaticResource Card}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NewEventViewModel}}, Path=SelectSuggestionCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <Border
                            Grid.Column="0"
                            BackgroundColor="{StaticResource Card}"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 10"
                            Padding="8,0">
                            <Entry
                                Placeholder="Custom tag…"
                                Text="{Binding TagInput}"
                                ReturnCommand="{Binding CommitTagInputCommand}"
                                ReturnType="Done"
                                FontSize="14" />
                        </Border>
                        <Button
                            Grid.Column="1"
                            Text="Add"
                            Command="{Binding CommitTagInputCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            IsVisible="{Binding HasTagInput}"
                            CornerRadius="8"
                            FontSize="13"
                            Padding="12,7" />
                    </Grid>

                </VerticalStackLayout>

                <!-- Divider + optional section label -->
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,4" />

                <!-- Error -->
                <Label
                    Style="{StaticResource ErrorLabel}"
                    Text="{Binding ErrorMessage}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullToBool}}" />

                <!-- Context -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="CONTEXT (OPTIONAL)" Style="{StaticResource SectionLabel}" />
                    <Border
                        Padding="8,0"
                        BackgroundColor="{StaticResource Card}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 10">
                        <Entry
                            Placeholder="Add context…"
                            Text="{Binding Context}"
                            FontSize="14" />
                    </Border>
                </VerticalStackLayout>

                <!-- Description -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="DESCRIPTION (OPTIONAL)" Style="{StaticResource SectionLabel}" />
                    <Border
                        Padding="8,0"
                        BackgroundColor="{StaticResource Card}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 10">
                        <Editor
                            Placeholder="Add details…"
                            Text="{Binding Description}"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="80"
                            FontSize="14" />
                    </Border>
                </VerticalStackLayout>

                <!-- Can Influence -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleInfluenceCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" Text="CAN INFLUENCE" Style="{StaticResource SectionLabel}" VerticalOptions="Center" />
                    <Switch
                        Grid.Column="1"
                        IsToggled="{Binding CanInfluence}"
                        OnColor="{StaticResource PositiveBar}"
                        VerticalOptions="Center" />
                </Grid>

                <!-- Loading indicator -->
                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{StaticResource Primary}"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
